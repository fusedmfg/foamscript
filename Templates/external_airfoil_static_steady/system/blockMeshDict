FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Based on airfoilWithLayers tutorial (parameterized domain extents)

vertices
(
    (-{{ domain_upstream }}  -{{ domain_span_half }}  -{{ domain_radial }})
    ( {{ domain_downstream }} -{{ domain_span_half }}  -{{ domain_radial }})
    ( {{ domain_downstream }}  {{ domain_span_half }}  -{{ domain_radial }})
    (-{{ domain_upstream }}   {{ domain_span_half }}  -{{ domain_radial }})
    (-{{ domain_upstream }}  -{{ domain_span_half }}   {{ domain_radial }})
    ( {{ domain_downstream }} -{{ domain_span_half }}   {{ domain_radial }})
    ( {{ domain_downstream }}  {{ domain_span_half }}   {{ domain_radial }})
    (-{{ domain_upstream }}   {{ domain_span_half }}   {{ domain_radial }})
);

{{- # Cell counts: streamwise and normal sized to ~4 cells per chord, 5 spanwise (matches tutorial) }}
{{- nx = math.ceil((domain_upstream + domain_downstream) / ref_length * 4) }}
{{- nz = math.ceil(2 * domain_radial / ref_length * 4) }}

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{ nx }} 5 {{ nz }}) simpleGrading (1 1 1)
);

edges
();

boundary
(
    airFlow
    {
        type patch;
        faces
        (
            (2 6 5 1)
            (0 4 7 3)
            (0 3 2 1)
            (4 5 6 7)
        );
    }

    front
    {
        type symmetryPlane;
        faces
        (
            (3 7 6 2)
        );
    }

    back
    {
        type symmetryPlane;
        faces
        (
            (1 5 4 0)
        );
    }
);

// ************************************************************************* //
