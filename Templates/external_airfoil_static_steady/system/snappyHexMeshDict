FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Based on airfoilWithLayers tutorial (parameterized refinement + domain)

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    airfoil.stl
    {
        name airfoil;
        type triSurfaceMesh;
    }
}

castellatedMeshControls
{
    maxLocalCells       1000000;
    maxGlobalCells      20000000;
    minRefinementCells  0;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 4;

    features
    (
        {
            file "airfoil.eMesh";
            level {{ feature_level }};
        }
    );

    refinementSurfaces
    {
        airfoil
        {
            level ({{ refinement_level_min }} {{ refinement_level_max }});
        }
    }

    resolveFeatureAngle 30;
    planarAngle         30;

    refinementRegions
    {
    }

    locationInMesh ({{ domain_downstream * 0.8 }} 0 {{ domain_radial * 0.8 }});
    allowFreeStandingZoneFaces true;
}

// Internal macro for mesh-motion solver (from tutorial)
_meshMotionSolver
{
    solver  displacementPointSmoothing;
    displacementPointSmoothingCoeffs
    {
        pointSmoother           laplacian;
        nPointSmootherIter      10;
    }
}

snapControls
{
    nSmoothPatch        3;
    tolerance           1.0;
    nSolveIter          30;
    nRelaxIter          5;

    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
    strictRegionSnap    true;

    ${_meshMotionSolver}
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.5;
    finalLayerThickness 0.3;
    minThickness        0.1;

    layers
    {
        airfoil
        {
            nSurfaceLayers  20;
        }
    }

    nGrow                   -1;
    featureAngle            180;
    maxFaceThicknessRatio   1000;
    nSmoothSurfaceNormals   1;
    nSmoothThickness        10;
    minMedialAxisAngle      90;
    maxThicknessToMedialRatio 0.3;
    nSmoothNormals          3;
    slipFeatureAngle        10;
    nRelaxIter              5;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
    nRelaxedIter            0;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      1e-8;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    relaxed
    {
        maxNonOrtho     75;
        minTetQuality   -1e30;
        minTwist        -1;
    }

    nSmoothScale    4;
    errorReduction  0.75;
}

mergeTolerance 1e-6;

// ************************************************************************* //
