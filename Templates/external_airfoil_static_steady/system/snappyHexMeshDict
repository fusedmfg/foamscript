FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Based on OpenFOAM v2512 mesh/snappyHexMesh/airfoilWithLayers tutorial

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    airfoil.stl   { type triSurfaceMesh; name airfoil; }
}

castellatedMeshControls
{
    maxLocalCells   1000000;
    maxGlobalCells  20000000;
    minRefinementCells 0;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 4;

    features
    (
        { file "airfoil.eMesh"; level 0; }
    );

    refinementSurfaces
    {
        airfoil
        {
            level ({{ refinement_level_min }} {{ refinement_level_max }});
            patchInfo { type wall; }
        }
    }

    refinementRegions
    {
    }

    resolveFeatureAngle 30;
    planarAngle 30;

    locationInMesh ({{ domain_downstream * 0.8 }} 0 {{ domain_radial * 0.8 }});

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       1.0;
    nSolveIter      30;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
    strictRegionSnap true;
}

addLayersControls
{
    layers
    {
        airfoil
        {
            nSurfaceLayers  20;
        }
    }
    relativeSizes       true;
    expansionRatio      1.5;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               -1;
    featureAngle        180;
    maxFaceThicknessRatio 1000;
    nSmoothSurfaceNormals 1;
    nSmoothThickness    10;
    minMedialAxisAngle  90;
    maxThicknessToMedialRatio 0.3;
    nSmoothNormals      3;
    slipFeatureAngle    10;
    nRelaxIter          5;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        0;
}

meshQualityControls
{
    #include "meshQualityDict"

    minDeterminant 1e-8;

    relaxed
    {
        maxNonOrtho 75;
        minTetQuality -1e30;
        minTwist    -1;
    }

    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;

// ************************************************************************* //
