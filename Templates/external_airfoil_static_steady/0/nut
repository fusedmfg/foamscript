FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform {{ nu_tilda }};

boundaryField
{
    airFlow
    {
        type            freestream;
        freestreamValue $internalField;
    }

    airfoil
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    front
    {
        type            symmetryPlane;
    }

    back
    {
        type            symmetryPlane;
    }
}

