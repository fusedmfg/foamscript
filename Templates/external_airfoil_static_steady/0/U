FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ({{ ux }} 0 {{ uz }});

boundaryField
{
    inlet
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }

    outlet
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }

    airfoil
    {
        type            noSlip;
    }

    lowerWall
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }

    upperWall
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }

    front
    {
        type            symmetryPlane;
    }

    back
    {
        type            symmetryPlane;
    }
}

