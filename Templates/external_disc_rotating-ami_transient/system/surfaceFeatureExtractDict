FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/constant/caseSettings"

disc.stl
{
    // Constant: Method for identifying sharp edges on the rim/bead
    extractionMethod    extractFromSurface;
    
    // Constant: 150 degrees is standard for capturing disc profiles
    includedAngle       150;
    
    writeObj            yes;
}

rotor.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;
    writeObj            yes;
}

