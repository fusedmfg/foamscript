FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    {
        name            rotor;
        patchInfo
        {
            type            cyclicAMI;
            matchTolerance  0.0001;
            neighbourPatch  rotor_slave;
            transform       noOrdering;
        }
        constructFrom patches;
        patches (rotor);
    }

    {
        name            rotor_slave;
        patchInfo
        {
            type            cyclicAMI;
            matchTolerance  0.0001;
            neighbourPatch  rotor;
            transform       noOrdering;
        }
        constructFrom patches;
        patches (rotor_slave);
    }
);

