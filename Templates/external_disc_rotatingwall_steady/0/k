FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{ k }};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform {{ k }};
    }

    outlet
    {
        type            zeroGradient;
    }

    tunnel
    {
        type            slip;
    }

    disc
    {
        type            kqRWallFunction;
        value           uniform {{ k }};
    }
}

