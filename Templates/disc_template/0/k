FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Hard-coded constant
dimensions      [0 2 -2 0 0 0 0];

// Parameterized: Calculates based on current wind speed
internalField   uniform {{ k }};

boundaryField
{
    inlet
    {
        // Explicitly setting the value based on the calculated study parameter
        type            fixedValue;
        value           uniform {{ k }};
    }

    outlet
    {
        type            zeroGradient;
    }

    tunnel
    {
        type            slip;
    }

    disc
    {
        // Standard wall function for k in k-omega SST
        type            kqRWallFunction;
        value           uniform {{ k }};
    }

    "rotor.*"
    {
        type            cyclicAMI;
        value           uniform {{ k }};
    }
}


