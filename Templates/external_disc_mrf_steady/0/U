FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Parameterized: Initialize to freestream velocity
internalField   uniform ({{ ux }} {{ uy }} 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ({{ ux }} {{ uy }} 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    tunnel
    {
        type            slip;
    }

    disc
    {
        type            noSlip;
    }
}

