{
  // ── Required ────────────────────────────────────────────────────────────────
  // These five fields must be provided in every config file.

  "projectName": "MyDiscStudy",           // Folder name and prefix for all case directories
  "outputDir": "/home/user/studies",      // Parent directory where the project folder is created
  "templateName": "external_disc_rotatingwall_steady", // Template name (run 'foamscript list-templates')
  "modelSource": "/home/user/disc.step",  // Path to geometry file: .step, .stp, .iges, .igs, or .stl
  "angles": "-10,-5,-2.5,0,2.5,5,10",    // Comma-separated angles of attack in degrees

  // ── Study options ────────────────────────────────────────────────────────────
  // All optional. Templates may provide defaults for velocity and rpm.

  "velocity": 27.0,           // Freestream velocity magnitude (m/s) — template may provide default
  "rpm": 925.0,               // Rotation speed (RPM) — only for rotating templates
  "modelSourceUnits": "mm",   // Source geometry units: mm | cm | m | in | ft (default: mm, ignored for .stl)
  "meshSize": 1.0,            // gmsh mesh size scaling factor for STEP/IGES conversion (default: 1.0, ignored for .stl)
  "cores": 0,                 // CPU cores (0 = auto-detect all available; set FOAMSCRIPT_MAX_CORES to limit)
  "run": true,                // Run full pipeline after study creation (mesh → solve → report)
  "skipReport": false,         // Skip report generation when run is true

  // ── Physics parameters ───────────────────────────────────────────────────────
  // Fluid properties and solver settings. All optional — defaults shown.

  "physics": {
    "nu": 1.5e-5,               // Kinematic viscosity (m²/s) — air at ~20°C sea level
    "turbulenceIntensity": 0.01, // Freestream turbulence intensity (0.01 = 1%, AIAA default)
    "maxIterations": 500,        // Maximum solver iterations (steady-state simpleFoam)
    "writeInterval": 100,        // Write results every N iterations
    "endTime": 1.0,              // Simulation end time in seconds (transient pimpleFoam only)
    "nOuterCorrectors": 1,       // PIMPLE outer corrector iterations
    "refinementLevelMin": 5,     // snappyHexMesh minimum refinement level around geometry
    "refinementLevelMax": 6,     // snappyHexMesh maximum refinement level around geometry
    "mixingLengthRatio": 0.07,   // Mixing length as fraction of reference length
    "nuTildaMultiplier": 3.0     // nu-tilda initial value multiplier (x nu)
  },

  // ── Domain geometry parameters ───────────────────────────────────────────────
  // Controls the size of the rotor zone and wind tunnel. All optional.
  // Scales and extents are relative to the geometry's reference length
  // (diameter for discs, chord for airfoils — determined by TEMPLATE.json).

  "domain": {
    "rotorRadiusScale": 1.25,  // Rotor cylinder radius = ref_radius × scale (rotating templates only)
    "rotorHeightScale": 1.5,   // Rotor cylinder height = geometry_height × scale (rotating templates only)
    "tunnelUpstream": 5.0,     // Wind tunnel upstream extent in reference lengths  (-x direction)
    "tunnelDownstream": 10.0,  // Wind tunnel downstream extent in reference lengths (+x direction)
    "tunnelRadial": 5.0,       // Wind tunnel radial extent in reference lengths    (+/-y and +/-z)
    "meshResolution": 32       // Number of vertices around generated cylinder geometries
  }
}
